# === DATABASE ===
# For LOCAL development (SQLite):
DATABASE_URL=file:./db/custom.db

# For Vercel/Production (Turso):
# Get these from https://turso.tech after creating your database
# DATABASE_URL=libsql://your-db-name-yourname.turso.io
# DIRECT_DATABASE_URL=libsql://your-db-name-yourname.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# === ADMIN ===
# Admin JWT secret (generate a random string)
AUTH_SECRET=your-random-secret-here
